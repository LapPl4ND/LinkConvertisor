<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>

		<AssemblyName>LinkConvertisor</AssemblyName>
		<Version>1.0.0</Version>
	</PropertyGroup>

	<!-- Icône : ajoute un app.ico à côté du .csproj et il sera utilisé automatiquement -->
	<PropertyGroup Condition="Exists('app.ico')">
		<ApplicationIcon>app.ico</ApplicationIcon>
	</PropertyGroup>
	<ItemGroup Condition="Exists('app.ico')">
		<Resource Include="app.ico" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="Assets\Logos\*.png" />
	</ItemGroup>

</Project>
